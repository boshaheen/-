# مفتاح Anthropic (Claude) API - مطلوب لتحليل الصور
ANTHROPIC_API_KEY=

# اسم النموذج (اختياري)
ANTHROPIC_MODEL=claude-sonnet-5

# مفتاح Resend لإرسال التقارير بالبريد الإلكتروني - اختياري
RESEND_API_KEY=

# البريد المُرسل منه (يجب أن يكون نطاقًا موثّقًا في Resend، وإلا استخدم onboarding@resend.dev للتجربة)
EMAIL_FROM=onboarding@resend.dev

# منفذ الخادم (اختياري)
PORT=8787

# نطاق مسموح له بالوصول من المتصفح (اختياري، افتراضيًا مفتوح)
CORS_ORIGIN=
